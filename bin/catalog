#!/usr/bin/env python3
"""catalog — regenerate ~/Videos/vidgen/CATALOG.md: every video, linked, with the exact prompt
that made it (2026-09-23). Sources: the .json sidecar vidgen writes next to each clip, and
project.txt inside each story folder. Run any time; the story runner runs it after a film."""
import json, re
from pathlib import Path
root = Path.home() / "Videos" / "vidgen"
out = ["# vidgen catalog", "", "Regenerated by `~/repos/local-video/bin/catalog`. Newest first. "
       "Paths are relative to this folder; click to open.", ""]
films = []
for d in sorted(root.iterdir()):
    if d.is_dir() and (d / "project.txt").exists():
        txt = (d / "project.txt").read_text()
        name = re.search(r"NAME=([\w-]+)", txt).group(1)
        bible = re.search(r"BIBLE='(.*?)'\n", txt, re.S)
        scenes = re.findall(r'^"(.*)"$', (re.search(r"^SCENES=\(\s*\n(.*?)^\)", txt, re.M | re.S) or [txt, txt])[1], re.M)
        final = d / f"{name}.mp4"
        mtime = final.stat().st_mtime if final.exists() else d.stat().st_mtime
        films.append((mtime, name, d, bible.group(1) if bible else "", scenes, final))
clips = []
for j in root.glob("*.json"):
    try:
        m = json.loads(j.read_text())
    except Exception:
        continue
    mp4 = j.with_suffix(".mp4")
    clips.append((mp4.stat().st_mtime if mp4.exists() else 0, mp4, m))
out.append("## Films (multi-scene)\n")
for mtime, name, d, bible, scenes, final in sorted(films, reverse=True):
    link = f"[{name}.mp4]({d.name}/{name}.mp4)" if final.exists() else f"{name} (in progress)"
    out.append(f"### {link}\n")
    if bible:
        out.append(f"**Shared paragraph (bible):** {bible}\n")
    for i, sc in enumerate(scenes, 1):
        sf = d / f"scene-{i}.mp4"
        tag = f"[scene {i}]({d.name}/scene-{i}.mp4)" if sf.exists() else f"scene {i} (not rendered)"
        out.append(f"- {tag}: {sc}")
    out.append("")
out.append("## Single clips\n")
for mtime, mp4, m in sorted(clips, key=lambda x: -x[0]):
    if not mp4.exists():
        continue
    mode = m.get("mode", "?"); size = m.get("size", "?"); secs = m.get("seconds") or "auto"
    out.append(f"- [{mp4.name}]({mp4.name}) — {mode}, {size}, {secs} s, seed {m.get('seed')}, "
               f"{m.get('wall_seconds')} s wall" + (f", image {m['image']}" if m.get("image") else ""))
    out.append(f"  - prompt: {m.get('prompt','')}")
(root / "CATALOG.md").write_text("\n".join(out) + "\n")
print(f"wrote {root/'CATALOG.md'}: {len(films)} films, {len(clips)} clips")
